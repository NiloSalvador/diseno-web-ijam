---
// Inicio de Café Orquídea, el ejemplo del curso (negocio ficticio).
// Las fotos viven en src/assets y se importan para que Astro las optimice.
import { Image } from 'astro:assets';
import fotoLocal from '../assets/local.jpg';
import fotoCafe from '../assets/cafe-pasado.jpg';
import fotoDesayuno from '../assets/desayuno.jpg';
import fotoPostre from '../assets/postre.jpg';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Café Orquídea | Cafetería en Rioja</title>
	</head>
	<body>
		<header>
			<a href="/">Café Orquídea</a>
			<nav aria-label="Principal">
				<ul>
					<li><a href="/" aria-current="page">Inicio</a></li>
					<li><a href="/carta">Carta</a></li>
					<li><a href="/nosotros">Nosotros</a></li>
					<li><a href="/contacto">Contacto</a></li>
				</ul>
			</nav>
		</header>

		<main>
			<section>
				<h1>Café Orquídea</h1>
				<p>Café de la provincia, desayunos y postres caseros en el centro de Rioja.</p>
				<Image
					src={fotoLocal}
					alt="Salón de Café Orquídea con mesas de madera, plantas y orquídeas junto a la ventana"
					width={640}
				/>
				<p><a class="boton" href="https://wa.me/51942123456">Pide por WhatsApp</a></p>
			</section>

			<section>
				<h2>Lo más pedido</h2>
				<article>
					<h3>Café pasado</h3>
					<Image src={fotoCafe} alt="Taza de café pasado con granos tostados sobre una mesa de madera" width={320} />
					<p>Café de altura del Alto Mayo, pasado en filtro de tela al momento.</p>
				</article>
				<article>
					<h3>Tacacho con cecina</h3>
					<Image src={fotoDesayuno} alt="Plato de tacacho con cecina, salsa criolla y una taza de café" width={320} />
					<p>El desayuno de la selva, con plátano verde asado y cecina ahumada.</p>
				</article>
				<article>
					<h3>Torta de chocolate</h3>
					<Image src={fotoPostre} alt="Tajada de torta de chocolate con cobertura de chocolate en un plato blanco" width={320} />
					<p>Hecha en casa cada mañana con cacao de San Martín.</p>
				</article>
				<p><a href="/carta">Ver la carta completa</a></p>
			</section>

			<section>
				<h2>Horario</h2>
				<p>De lunes a viernes, de 7:00 a. m. a 9:00 p. m. Los sábados, de 8:00 a. m. a 2:00 p. m.</p>
			</section>
		</main>

		<footer>
			<address>
				Jr. Grau 345, Rioja, San Martín<br />
				<a href="tel:+51942123456">Llamar al 942 123 456</a>
			</address>
			<p>Café Orquídea es un negocio ficticio, creado para el curso Diseño Web del IESTP John A. Mackay.</p>
		</footer>
	</body>
</html>

<style>
	/* Una regla dice a quién (el selector) y qué le cambia (las declaraciones, propiedad: valor;).
	   En Astro, este <style> solo afecta a esta página: las demás no lo ven. */
	body {
		margin: 0;
		background-color: #f6efe4; /* crema, el fondo de la marca */
		color: #2b1b12;
		font-family: system-ui, sans-serif;
		font-size: 1.0625rem; /* 17 px, porque 1 rem son los 16 px del navegador */
		line-height: 1.6;
	}

	/* Cascada. Los títulos heredan el color del body, pero esta regla les habla directo y gana. */
	h1,
	h2,
	h3 {
		font-family: Georgia, serif;
		color: #6b3e26; /* café */
		line-height: 1.15;
	}

	/* Modelo de caja. El padding es el relleno entre el borde y el contenido. */
	header {
		background-color: #1f4d3a; /* verde selva */
		padding: 1rem 1.5rem;
	}

	header a {
		color: #f6efe4;
		font-weight: 600;
		text-decoration: none;
	}

	/* El margin es el espacio de afuera. Con auto a los lados, la caja queda centrada. */
	main {
		max-width: 48rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	img {
		max-width: 100%; /* nunca más ancha que su caja, también en el celular */
		height: auto;
		border-radius: 1rem;
	}

	a {
		color: #8e3462;
	}

	/* La caja completa: contenido, padding, borde y margin. La clase gana a la regla «a». */
	.boton {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border: 2px solid #b5487e;
		border-radius: 999px;
		margin-top: 1rem;
		background-color: #b5487e; /* orquídea, el acento de lo que se puede pulsar */
		color: #fcf9f4;
		font-weight: 600;
		text-decoration: none;
	}
</style>
