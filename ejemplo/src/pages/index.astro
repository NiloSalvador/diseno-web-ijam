---
// Inicio de Café Orquídea, el ejemplo del curso (negocio ficticio). Sigue el boceto del brief:
// foto grande con el nombre y el botón, los tres productos más pedidos y el horario junto al mapa.
// «Lo más pedido» sale de src/data/carta.js y cada producto se muestra con el componente TarjetaProducto.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
import Horario from '../components/Horario.astro';
import { masPedidos } from '../data/carta.js';
import { negocio } from '../data/negocio.js';
import fotoLocal from '../assets/local.jpg';
---

<Layout
	title="Café Orquídea | Cafetería en Rioja"
	description="Café de la provincia, desayunos y postres caseros en el centro de Rioja, San Martín. Mira la carta y el horario, y pide por WhatsApp."
>
	<section class="relative isolate overflow-hidden bg-cafe-oscuro">
		<Image
			src={fotoLocal}
			alt="Salón de Café Orquídea con mesas de madera, plantas y orquídeas junto a la ventana"
			widths={[640, 960, 1216]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 -z-10 size-full object-cover"
		/>
		<div class="absolute inset-0 -z-10 bg-linear-to-b from-cafe-oscuro/60 via-cafe-oscuro/70 to-cafe-oscuro/85"></div>
		<div
			class="mx-auto flex min-h-136 max-w-3xl flex-col items-center justify-center px-4 py-20 text-center sm:px-6 md:min-h-160"
		>
			<h1 class="text-5xl text-crema sm:text-6xl lg:text-7xl">Café Orquídea</h1>
			<p class="mt-5 max-w-md text-lg text-crema sm:text-xl">
				Café de la provincia, desayunos y postres caseros en el centro de Rioja.
			</p>
			<div class="mt-9">
				<BotonWhatsapp />
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<h2 class="text-3xl md:text-4xl">Lo más pedido</h2>
			<a
				href="/carta"
				class="inline-flex min-h-11 items-center font-semibold text-orquidea-oscuro underline decoration-orquidea/40 underline-offset-4 transition hover:decoration-orquidea"
			>
				Ver la carta completa
			</a>
		</div>
		<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{masPedidos.map((producto) => <TarjetaProducto {...producto} />)}
		</div>
	</section>

	<div class="mx-auto grid max-w-6xl gap-6 px-4 pb-16 sm:px-6 md:grid-cols-2 md:pb-24">
		<Horario>
			<p class="mt-6 flex items-start gap-3 text-cafe">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					class="mt-0.5 size-5 shrink-0 text-selva"
				>
					<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
					<circle cx="12" cy="10" r="3"></circle>
				</svg>
				<span>{negocio.direccion}. {negocio.referencia}.</span>
			</p>
		</Horario>
		<iframe
			src="https://www.google.com/maps?q=Plaza+de+Armas+de+Rioja,+San+Martin,+Peru&z=17&output=embed"
			title="Mapa de Café Orquídea, junto a la Plaza de Armas de Rioja"
			width="600"
			height="400"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			class="h-full min-h-80 w-full rounded-3xl bg-crema-oscuro shadow-lg shadow-cafe-oscuro/10 ring-1 ring-crema-oscuro"
		></iframe>
	</div>
</Layout>
