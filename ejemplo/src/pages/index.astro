---
// Inicio de Café Orquídea, el ejemplo del curso (negocio ficticio).
// Las fotos viven en src/assets y se importan para que Astro las optimice.
import { Image } from 'astro:assets';
import fotoLocal from '../assets/local.jpg';
// El molde de página pone el <head>, la cabecera, el pie, las fuentes y los estilos.
import Layout from '../layouts/Layout.astro';
// La tarjeta de producto es un componente: se escribe una vez y se usa con distintos datos.
import Tarjeta from '../components/Tarjeta.astro';
// Los productos y la función que escribe los precios en soles vienen del archivo de datos.
import { productos, soles } from '../data/carta.js';

// La base del sitio, la carpeta donde GitHub Pages lo publica (/diseno-web-ijam). Sale de «base» en
// astro.config.mjs. El .replace quita la barra del final si la tiene, así cada enlace se escribe
// igual, la base y luego la ruta que empieza con /.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Café Orquídea | Cafetería en Rioja" description="Café de la provincia, desayunos de la selva y postres caseros a media cuadra de la Plaza de Armas de Rioja. Pide por WhatsApp y pasa a recoger." pagina="/">
	<main>
		<section class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-2 md:items-center md:gap-10 md:py-16">
			<div class="space-y-6">
				<h1 class="font-titulo text-4xl font-semibold leading-tight text-cafe sm:text-5xl lg:text-6xl">Café Orquídea</h1>
				<p class="text-lg sm:text-xl">Café de la provincia, desayunos y postres caseros en el centro de Rioja.</p>
				<p><a href="https://wa.me/51942123456" class="inline-block rounded-full bg-orquidea px-6 py-3 font-semibold text-crema-claro hover:bg-orquidea-oscuro">Pide por WhatsApp</a></p>
			</div>
			<Image class="w-full rounded-3xl"
				src={fotoLocal}
				alt="Salón de Café Orquídea con mesas de madera, plantas y orquídeas junto a la ventana"
				width={720}
			/>
		</section>

		<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<h2 class="font-titulo text-3xl font-semibold text-cafe md:text-4xl">Lo más pedido</h2>
				<a href={`${base}/carta`} class="font-semibold text-orquidea-oscuro underline underline-offset-4 hover:text-orquidea">Ver la carta completa</a>
			</div>
			<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{productos.map((producto) => (
					<Tarjeta
						nombre={producto.nombre}
						descripcion={producto.descripcion}
						precio={soles(producto.precio)}
						foto={producto.foto}
						alt={producto.alt}
					/>
				))}
			</div>
		</section>

		<div class="mx-auto grid max-w-6xl gap-6 px-4 pb-16 sm:px-6 md:grid-cols-2">
			<section class="space-y-3 rounded-3xl bg-crema-claro p-6 sm:p-8 shadow-lg shadow-cafe-oscuro/10">
				<h2 class="font-titulo text-3xl font-semibold text-cafe">Horario</h2>
				<p>De lunes a viernes, de 7:00 a. m. a 9:00 p. m. Los sábados, de 8:00 a. m. a 2:00 p. m.</p>
			</section>
			<section class="space-y-3 rounded-3xl bg-selva p-6 sm:p-8 text-crema">
				<h2 class="font-titulo text-3xl font-semibold text-crema">Dónde estamos</h2>
				<p>Jr. Grau 345, a media cuadra de la Plaza de Armas de Rioja.</p>
				<p><a href={`${base}/contacto`} class="font-semibold text-orquidea-claro underline underline-offset-4">Ver el mapa</a></p>
			</section>
		</div>
	</main>
</Layout>
