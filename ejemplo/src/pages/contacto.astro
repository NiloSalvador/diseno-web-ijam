---
// Contacto: WhatsApp, teléfono, dirección con mapa, horario y preguntas frecuentes.
// El mapa es un iframe de Google Maps; su «title» dice qué hay dentro para quien usa lector de pantalla.
// El molde de página pone el <head>, la cabecera, el pie, las fuentes y los estilos.
import Layout from '../layouts/Layout.astro';

// Las preguntas frecuentes. Cada una se pinta abajo con <details> y <summary>, y el navegador la
// abre y la cierra solo al pulsar la pregunta, sin JavaScript.
const preguntas = [
	{
		pregunta: '¿Puedo reservar una mesa?',
		respuesta: 'Sí. Escríbenos por WhatsApp con el día, la hora y cuántas personas vienen, y te confirmamos la reserva.',
	},
	{
		pregunta: '¿Puedo pedir para recoger?',
		respuesta: 'Sí. Mándanos tu pedido por WhatsApp y dinos a qué hora pasas. Te lo tenemos listo en la barra.',
	},
	{
		pregunta: '¿Hacen envíos a domicilio?',
		respuesta: 'Por ahora no. Pide por WhatsApp y recoge tu pedido en Jr. Grau 345, a media cuadra de la Plaza de Armas.',
	},
	{
		pregunta: '¿De dónde es el café que sirven?',
		respuesta: 'De fincas de la provincia de Rioja, en el Alto Mayo. Lo preparamos pasado, espresso o con leche.',
	},
];
---

<Layout title="Contacto | Café Orquídea" description="Escríbenos por WhatsApp, llámanos o visítanos en Jr. Grau 345, Rioja. Horario de atención y mapa para llegar a Café Orquídea." pagina="/contacto">
	<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-16">
		<h1 class="font-titulo text-4xl font-semibold leading-tight text-cafe sm:text-5xl lg:text-6xl">Contacto</h1>

		<div class="mt-10 grid gap-10 md:grid-cols-2">
			<div class="space-y-10">
				<section class="space-y-4">
					<h2 class="font-titulo text-3xl font-semibold text-cafe">Pide o reserva</h2>
					<p>Escríbenos para pedir y recoger, o para reservar una mesa para tu grupo.</p>
					<ul class="flex flex-wrap gap-3">
						<li><a href="https://wa.me/51942123456" class="inline-block rounded-full bg-orquidea px-6 py-3 font-semibold text-crema-claro hover:bg-orquidea-oscuro">Escríbenos por WhatsApp</a></li>
						<li><a href="tel:+51942123456" class="inline-block rounded-full border-2 border-selva px-6 py-3 font-semibold text-selva hover:bg-selva hover:text-crema">Llámanos al 942 123 456</a></li>
					</ul>
				</section>

				<section class="space-y-3 rounded-3xl bg-crema-claro p-6 sm:p-8 shadow-lg shadow-cafe-oscuro/10">
					<h2 class="font-titulo text-3xl font-semibold text-cafe">Horario</h2>
					<ul class="list-disc pl-6">
						<li>Lunes a viernes, de 7:00 a. m. a 9:00 p. m.</li>
						<li>Sábados, de 8:00 a. m. a 2:00 p. m.</li>
						<li>Domingos y feriados, cerrado.</li>
					</ul>
				</section>
			</div>

			<section class="flex flex-col gap-4">
				<h2 class="font-titulo text-3xl font-semibold text-cafe">Dónde estamos</h2>
				<address class="not-italic">Jr. Grau 345, a media cuadra de la Plaza de Armas de Rioja, San Martín</address>
				<iframe
					class="min-h-80 w-full flex-1 rounded-3xl"
					src="https://www.google.com/maps?q=Plaza+de+Armas+de+Rioja,+San+Martin,+Peru&z=17&output=embed"
					title="Mapa de Café Orquídea, junto a la Plaza de Armas de Rioja"
					width="600"
					height="400"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
				></iframe>
			</section>
		</div>

		<section class="mt-16 max-w-3xl space-y-4">
			<h2 class="font-titulo text-3xl font-semibold text-cafe">Preguntas frecuentes</h2>
			{preguntas.map((p) => (
				<details class="rounded-2xl bg-crema-claro shadow-md shadow-cafe-oscuro/10">
					<summary class="cursor-pointer p-5 font-semibold text-cafe marker:text-orquidea hover:text-orquidea-oscuro">{p.pregunta}</summary>
					<p class="px-5 pb-5">{p.respuesta}</p>
				</details>
			))}
		</section>
	</main>
</Layout>
