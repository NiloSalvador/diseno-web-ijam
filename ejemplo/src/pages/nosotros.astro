---
// Nosotros: la historia del café, de dónde viene el grano y el horario.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
import Horario from '../components/Horario.astro';
import fotoGranos from '../assets/granos.jpg';

// Tres datos de la historia que se muestran en tarjetas.
const datos = [
	{ etiqueta: 'Abrimos en', valor: '2019' },
	{ etiqueta: 'Empezamos con', valor: '4 mesas' },
	{ etiqueta: 'Tostamos el grano', valor: 'Cada semana' },
];
---

<Layout
	title="Nosotros | Café Orquídea"
	description="La historia de Café Orquídea, una cafetería del centro de Rioja que sirve café de familias productoras del Alto Mayo."
>
	<section class="border-b border-crema-oscuro bg-crema-oscuro/40">
		<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
			<p class="text-sm font-semibold tracking-widest text-selva uppercase">Desde 2019 en Rioja</p>
			<h1 class="mt-3 text-4xl sm:text-5xl">Nosotros</h1>
			<p class="mt-5 max-w-2xl text-lg text-cafe">
				Una cafetería pequeña del centro de Rioja que sirve el café que se cultiva a pocos kilómetros de la ciudad.
			</p>
		</div>
	</section>

	<section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-5 md:gap-16 md:py-24">
		<div class="md:col-span-3">
			<h2 class="text-3xl md:text-4xl">Nuestra historia</h2>
			<p class="mt-5 text-lg leading-relaxed">
				Café Orquídea abrió en 2019 en el centro de Rioja con cuatro mesas y una cafetera prestada. La idea era
				sencilla, servir el café que se cultiva a pocos kilómetros de la ciudad, preparado como en casa.
			</p>
			<p class="mt-4 text-lg leading-relaxed">
				Hoy atendemos a quienes pasan antes del trabajo, a estudiantes que se reúnen por la tarde y a viajeros que
				cruzan el Alto Mayo.
			</p>
		</div>
		<dl class="grid gap-4 sm:grid-cols-3 md:col-span-2 md:grid-cols-1">
			{
				datos.map((dato) => (
					<div class="rounded-3xl bg-crema-claro p-6 shadow-lg shadow-cafe-oscuro/10 ring-1 ring-crema-oscuro">
						<dt class="text-sm font-semibold tracking-widest text-cafe uppercase">{dato.etiqueta}</dt>
						<dd class="mt-1 font-titulo text-3xl font-semibold text-selva">{dato.valor}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="mx-auto max-w-6xl px-4 sm:px-6">
		<Image
			src={fotoGranos}
			alt="Rama de cafeto con granos maduros de color rojo en una finca de la selva alta"
			widths={[640, 960, 1216]}
			sizes="(min-width: 1152px) 1152px, 100vw"
			class="aspect-4/3 w-full rounded-3xl object-cover shadow-xl shadow-cafe-oscuro/15 md:aspect-21/9"
		/>
		<div class="mt-8 grid gap-4 md:mt-10 md:grid-cols-5 md:gap-16">
			<h2 class="text-3xl md:col-span-2 md:text-4xl">De dónde viene nuestro café</h2>
			<p class="text-lg leading-relaxed md:col-span-3">
				Compramos el grano a familias productoras de Rioja y Nueva Cajamarca. Lo tostamos cada semana en pequeñas
				cantidades, para que llegue fresco a la taza.
			</p>
		</div>
	</section>

	<div class="mx-auto grid max-w-6xl gap-6 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
		<Horario />
		<section class="rounded-3xl bg-crema-oscuro/50 p-6 ring-1 ring-crema-oscuro sm:p-8">
			<h2 class="text-2xl">Pasa a visitarnos</h2>
			<p class="mt-3 text-lg text-cafe">
				Reserva una mesa para tu grupo o pide para recoger. Te respondemos por WhatsApp en el horario de atención.
			</p>
			<div class="mt-6">
				<BotonWhatsapp texto="Reserva por WhatsApp" />
			</div>
		</section>
	</div>
</Layout>
