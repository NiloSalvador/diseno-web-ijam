---
// Carta de Café Orquídea, en tarjetas con foto como pide el brief. Las categorías y los precios
// salen de src/data/carta.js. Cada categoría es una tabla: los encabezados van en <th> para que
// el lector de pantalla diga «Producto» y «Precio» al leer cada fila.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
import { carta } from '../data/carta.js';
---

<Layout
	title="Carta | Café Orquídea"
	description="La carta de Café Orquídea en Rioja. Café pasado, desayunos de la selva y postres caseros, con sus precios en soles."
>
	<section class="border-b border-crema-oscuro bg-crema-oscuro/40">
		<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-20">
			<h1 class="text-4xl sm:text-5xl">Nuestra carta</h1>
			<p class="mt-5 max-w-xl text-lg text-cafe">
				Precios en soles, con IGV incluido. Para pedir y recoger, escríbenos por WhatsApp.
			</p>
			<div class="mt-8">
				<BotonWhatsapp />
			</div>
		</div>
	</section>

	<div class="mx-auto grid max-w-6xl items-start gap-6 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-20 lg:grid-cols-3">
		{
			carta.map((grupo, posicion) => (
				<article class="overflow-hidden rounded-3xl bg-crema-claro shadow-lg shadow-cafe-oscuro/10 ring-1 ring-crema-oscuro">
					<Image
						src={grupo.foto}
						alt={grupo.alt}
						widths={[400, 720]}
						sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw"
						loading={posicion === 0 ? 'eager' : 'lazy'}
						class="aspect-video w-full object-cover"
					/>
					<div class="p-6 sm:p-8">
						<table class="w-full">
							<caption class="text-left">
								<span class="block font-titulo text-2xl font-semibold text-cafe">{grupo.categoria}</span>
								<span class="mt-1 block text-cafe">{grupo.descripcion}</span>
							</caption>
							<thead>
								<tr class="border-b-2 border-crema-oscuro">
									<th scope="col" class="pt-5 pb-2 text-left text-xs font-semibold tracking-widest text-cafe uppercase">
										Producto
									</th>
									<th scope="col" class="pt-5 pb-2 text-right text-xs font-semibold tracking-widest text-cafe uppercase">
										Precio
									</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-crema-oscuro">
								{grupo.productos.map((producto) => (
									<tr>
										<td class="py-3 pr-4">{producto.nombre}</td>
										<td class="py-3 text-right font-semibold whitespace-nowrap text-selva tabular-nums">
											S/ {producto.precio.toFixed(2)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</article>
			))
		}
	</div>

	<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 md:pb-24">
		<div
			class="flex flex-col items-start gap-6 rounded-3xl bg-crema-oscuro/60 p-8 ring-1 ring-crema-oscuro sm:p-10 md:flex-row md:items-center md:justify-between"
		>
			<div>
				<h2 class="text-3xl">¿Ya elegiste?</h2>
				<p class="mt-2 max-w-lg text-lg text-cafe">
					Escríbenos qué vas a llevar y a qué hora pasas. Lo tenemos listo para que lo recojas.
				</p>
			</div>
			<BotonWhatsapp />
		</div>
	</section>
</Layout>
