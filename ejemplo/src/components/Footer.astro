---
// Pie de página con la dirección, el teléfono y las redes, como en el boceto.
// Los datos salen de src/data/negocio.js.
import { negocio } from '../data/negocio.js';

const enlaceDelPie =
	'inline-flex min-h-11 items-center underline decoration-crema/40 underline-offset-4 transition hover:text-orquidea-claro hover:decoration-orquidea-claro focus-visible:outline-orquidea-claro';
---

<footer class="bg-cafe-oscuro text-crema">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-3">
		<div>
			<p class="font-titulo text-2xl font-semibold">{negocio.nombre}</p>
			<p class="mt-3 max-w-xs text-crema/75">
				Café de la provincia, desayunos y postres caseros en el centro de Rioja.
			</p>
		</div>

		<div>
			<h2 class="font-texto text-sm font-semibold tracking-widest text-orquidea-claro uppercase">Visítanos</h2>
			<address class="mt-3 text-crema/85 not-italic">
				{negocio.direccion}<br />
				{negocio.referencia}
			</address>
			<p class="mt-2 text-crema/85">De lunes a sábado</p>
		</div>

		<div>
			<h2 class="font-texto text-sm font-semibold tracking-widest text-orquidea-claro uppercase">Escríbenos</h2>
			<ul class="mt-2">
				<li><a href={negocio.whatsapp} class={enlaceDelPie}>Pide por WhatsApp</a></li>
				<li><a href={negocio.telefono} class={enlaceDelPie}>Llamar al {negocio.telefonoVisible}</a></li>
			</ul>
			<p class="mt-2 text-crema/85">{negocio.redes}</p>
		</div>
	</div>

	<div class="border-t border-crema/15">
		<div
			class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-crema/70 sm:px-6 md:flex-row md:justify-between md:gap-6"
		>
			<p>Café Orquídea es un negocio ficticio, creado para el curso Diseño Web del IESTP John A. Mackay.</p>
			<p class="shrink-0">© 2026 Café Orquídea</p>
		</div>
	</div>
</footer>
